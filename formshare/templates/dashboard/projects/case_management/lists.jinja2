{% extends 'dashboard/page.jinja2' %}
{% import 'dashboard/macros/form.jinja2' as form %}

{% block titlesection %}{{ _("Published lists") }}{% endblock titlesection %}

{% block breadcrumbs %}
    {% include 'dashboard/projects/case_management/snippets/brdcrbs_case_lists.jinja2' %}
{% endblock breadcrumbs %}

{% block maincontent %}
    <div class="row">
        <div class="col-lg-12">
            {% block form_errors %}
                {{ form.display_errors(errors) }}
            {% endblock form_errors %}
            <div class="ibox">
                <div class="ibox-content">
                    <h2>{{ _('Published lists') }}</h2>
                    <p>
                        {{ _('A published list is a real-time file generated from the data of a form and sent to the devices as a form attachment. A follow-up form uses it with select_one_from_file, naming the file exactly as it appears here.') }}
                    </p>
                    <a class="btn btn-primary" href="{{ request.route_url('project_case_list_add', userid=userid, projcode=projcode) }}">{{ _('Publish a new list') }}</a>
                    <hr class="hr-line-dashed">
                    {% if lists %}
                        <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>{{ _('File name') }}</th>
                                <th>{{ _('Source form') }}</th>
                                <th>{{ _('Source table') }}</th>
                                <th>{{ _('Label column') }}</th>
                                <th>{{ _('Rows') }}</th>
                                <th>{{ _('Edition') }}</th>
                                <th>{{ _('Last generated') }}</th>
                                <th>{{ _('Actions') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for a_list in lists %}
                                <tr>
                                    <td><code>{{ a_list.list_filename }}</code></td>
                                    <td>{{ a_list.source_form }}</td>
                                    <td>{{ a_list.source_table }}</td>
                                    <td>{{ a_list.label_column }}</td>
                                    <td>{% if a_list.list_active == 0 %}{{ _('Inactive') }}{% else %}{{ _('Active') }}{% endif %}</td>
                                    <td>{{ a_list.list_seq }}</td>
                                    <td>{% if a_list.list_lastgen %}{{ a_list.list_lastgen }}{% else %}{{ _('Never') }}{% endif %}</td>
                                    <td>
                                        <a class="btn btn-xs btn-white" href="{{ request.route_url('project_case_list_edit', userid=userid, projcode=projcode, listid=a_list.list_id) }}">{{ _('Edit') }}</a>
                                        <a class="btn btn-xs btn-white" href="{{ request.route_url('project_case_list_sample', userid=userid, projcode=projcode, listid=a_list.list_id) }}"><i class="fas fa-download"></i> {{ _('Sample CSV') }}</a>
                                        <a urn="{{ request.route_url('project_case_list_delete', userid=userid, projcode=projcode, listid=a_list.list_id) }}" class="btn btn-xs btn-danger remove_list"><i class="fas fa-trash"></i> {{ _('Delete') }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p>{{ _('This project publishes no lists yet.') }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock maincontent %}

{% block scripts %}
    {{ super() }}
    <script>
        $(document).ready(function() {
            $('.remove_list').click(function () {
                var action_url = $( this ).attr('urn');
                swal({
                        title: "{{ _('Are you sure?') }}",
                        text: "{{ _('Forms that reference this file will stop receiving fresh data.') }}",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#DD6B55",
                        confirmButtonText: "{{ _('Yes, delete it!') }}",
                        cancelButtonText: "{{ _('Oops!, cancel!') }}",
                        closeOnConfirm: true,
                        closeOnCancel: true },
                    function (isConfirm) {
                        if (isConfirm) {
                            var form = document.createElement('form');
                            form.setAttribute('method', 'post');
                            form.setAttribute('action', action_url);
                            form.style.display = 'hidden';

                            var i = document.createElement("input");
                            i.setAttribute('type',"text");
                            i.setAttribute('name',"csrf_token");
                            i.setAttribute('value','{{ request.session.get_csrf_token() }}');
                            form.appendChild(i);

                            document.body.appendChild(form);
                            $("#busy").show();
                            form.submit();
                        }
                    });
            });
        });
    </script>
{% endblock scripts %}
