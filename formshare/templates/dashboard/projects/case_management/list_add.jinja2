{% extends 'dashboard/page.jinja2' %}
{% import 'dashboard/macros/form.jinja2' as form %}

{% block titlesection %}{{ _("Publish a list") }}{% endblock titlesection %}

{% block css %}
    {{ super() }}
    {% cssresource request,'formshare','select2' %}
{% endblock css %}

{% block topScripts %}
    {{ super() }}
    {% jsresource request,'formshare','select2' %}
{% endblock topScripts %}

{% block breadcrumbs %}
    {% set crumb_current = _('Publish a list') %}
    {% include 'dashboard/projects/case_management/snippets/brdcrbs_case_lists.jinja2' %}
{% endblock breadcrumbs %}

{% block maincontent %}
    <div class="row">
        <div class="col-lg-12">
            {% block form_errors %}
                {{ form.display_errors(errors) }}
            {% endblock form_errors %}
            <div class="ibox">
                <div class="ibox-content">
                    <h2>{{ _('Publish a list') }}</h2>
                    <p>{{ _('Choose the form and table the cases come from, the column that labels each case, and the file name that follow-up forms will reference.') }}</p>
                    <form method="post" class="form-horizontal">
                        {{ form.secure_form(request) }}
                        <div class="form-group row">
                            <label class="col-sm-2 col-form-label">{{ _('List code') }}</label>
                            <div class="col-sm-10">
                                <input type="text" name="list_id" class="form-control" value="{{ listData.list_id }}" placeholder="cases">
                                <span class="form-text m-b-none">{{ _('A short internal code for the list. Lower case, no spaces.') }}</span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-2 col-form-label">{{ _('File name') }}</label>
                            <div class="col-sm-10">
                                <input type="text" name="list_filename" class="form-control" value="{{ listData.list_filename }}" placeholder="cases.csv">
                                <span class="form-text m-b-none">{{ _('The exact name a form must use in select_one_from_file. Lower case, ending in .csv') }}</span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-2 col-form-label">{{ _('Source form') }}</label>
                            <div class="col-sm-10">
                                <select name="source_form" class="form-control" id="source_form" style="width: 100%">
                                    <option value="">{{ _('Select a form with a repository') }}</option>
                                    {% for a_form in forms %}
                                        <option value="{{ a_form.form_id }}">{{ a_form.form_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-2 col-form-label">{{ _('Source table') }}</label>
                            <div class="col-sm-10">
                                <select name="source_table" class="form-control" id="source_table" style="width: 100%">
                                    <option value="">{{ _('Select the form first') }}</option>
                                </select>
                                <span class="form-text m-b-none">{{ _('maintable holds one row per submission; the table of a repeat holds one row per repeat entry.') }}</span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-2 col-form-label">{{ _('Label column') }}</label>
                            <div class="col-sm-10">
                                <select name="label_column" class="form-control" id="label_column" style="width: 100%">
                                    <option value="">{{ _('Select the table first') }}</option>
                                </select>
                                <span class="form-text m-b-none">{{ _('The column whose value names each case on the device.') }}</span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-2 col-form-label">{{ _('Rows to serve') }}</label>
                            <div class="col-sm-10">
                                <select name="list_active" class="form-control">
                                    <option value="1" {% if listData.list_active != "0" %}selected{% endif %}>{{ _('Active cases') }}</option>
                                    <option value="0" {% if listData.list_active == "0" %}selected{% endif %}>{{ _('Inactive cases') }}</option>
                                </select>
                                <span class="form-text m-b-none">{{ _('An active list serves cases that are still in play; an inactive list serves the ones that were deactivated.') }}</span>
                            </div>
                        </div>
                        <div class="hr-line-dashed"></div>
                        <button type="submit" class="btn btn-primary">{{ _('Publish the list') }}</button>
                        <a class="btn btn-white" href="{{ request.route_url('project_case_lists', userid=userid, projcode=projcode) }}">{{ _('Cancel') }}</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock maincontent %}

{% block scripts %}
    {{ super() }}
    <script>
        $(document).ready(function() {
            $("#source_form").select2();
            $("#source_table").select2();
            $("#label_column").select2();

            var tables_url = '{{ request.route_url('project_form_tables_api', userid=userid, projcode=projcode, formid='__FORM__') }}';
            var fields_url = '{{ request.route_url('project_table_fields_api', userid=userid, projcode=projcode, formid='__FORM__', tablename='__TABLE__') }}';

            $('#source_form').change(function () {
                var form_id = $(this).val();
                var table_combo = $('#source_table');
                table_combo.empty();
                $('#label_column').empty();
                if (form_id === '') {
                    table_combo.append(new Option("{{ _('Select the form first') }}", ''));
                    return;
                }
                $.getJSON(tables_url.replace('__FORM__', encodeURIComponent(form_id)), function (data) {
                    table_combo.append(new Option('', ''));
                    $.each(data.tables, function (index, a_table) {
                        var label = a_table.table_name;
                        if (a_table.table_desc) {
                            label = a_table.table_name + ' (' + a_table.table_desc + ')';
                        }
                        table_combo.append(new Option(label, a_table.table_name));
                    });
                    table_combo.trigger('change.select2');
                });
            });

            $('#source_table').change(function () {
                var form_id = $('#source_form').val();
                var table_name = $(this).val();
                var field_combo = $('#label_column');
                field_combo.empty();
                if (form_id === '' || table_name === '') {
                    return;
                }
                $.getJSON(
                    fields_url.replace('__FORM__', encodeURIComponent(form_id)).replace('__TABLE__', encodeURIComponent(table_name)),
                    function (data) {
                        field_combo.append(new Option('', ''));
                        $.each(data.fields, function (index, a_field) {
                            field_combo.append(new Option(a_field, a_field));
                        });
                        field_combo.trigger('change.select2');
                    });
            });
        });
    </script>
{% endblock scripts %}
