{% extends 'dashboard/page.jinja2' %}
{% import 'dashboard/macros/form.jinja2' as form %}

{% block titlesection %}{{ _("Edit project") }}{% endblock titlesection %}

{% block css %}
    {{ super() }}
    {% cssresource request,'formshare','bsmarkdown' %}
    {% cssresource request,'formshare','switchery' %}
    {% cssresource request,'formshare','colorpicker' %}
    {% cssresource request,'formshare','emoji' %}
    {% cssresource request,'formshare','select2' %}
    <style>
        .evo-palette {
            background-color: lightgrey;
        }
        .evo-pop {
            background-color: lightgrey;
        }
    </style>
{% endblock css %}

{% block topScripts %}
    {{ super() }}
    {% jsresource request,'formshare','markdown' %}
    {% jsresource request,'formshare','switchery' %}
    {% jsresource request,'formshare','select2' %}
{% endblock topScripts %}

{% block breadcrumbs %}
    {% include 'dashboard/projects/snippets/brdcrbs_prjedit.jinja2' %}
{% endblock breadcrumbs %}

{% block maincontent %}
    <div class="ibox">
        <div class="ibox-title">
            <h5>{{ projectDetails.project_name }}</h5>
            <div class="ibox-tools">
                <a class="fullscreen-link">
                    <i class="fa fa-expand"></i>
                </a>
            </div>
        </div>
        <div class="ibox-content">
            {% block form_errors %}
                {{ form.display_errors(errors) }}
            {% endblock form_errors %}
            {# A page that extends this one may show a form that extends this one's #}
            {% block project_form_include %}
                {% include 'dashboard/projects/snippets/project_form_edit.jinja2' %}
            {% endblock project_form_include %}
        </div>
    </div>
{% endblock maincontent %}

{% block scripts %}
    {{ super() }}
    {% jsresource request,'formshare','emoji' %}
    {% jsresource request,'formshare','jqueryui' %}
    {% jsresource request,'formshare','colorpicker' %}
    <script>
        $(document).ready(function() {
            {% if request.h.get_setting(request,'use_timezones','False') == 'True' %}
                $("#project_timezone").select2();
            {% endif %}
            // The edit form shows the case switch to no project any more
            // (2026-09-14): without one, Switchery would throw and stop what
            // follows.
            var elem = document.querySelector('.js-switch');
            if (elem) {
                var switchery = new Switchery(elem, { color: '#1AB394' });
            }

            var elem2 = document.querySelector('.js-switch2');
            var switchery2 = new Switchery(elem2, { color: '#1AB394' });

            $('#noIndColor').colorpicker({
                displayIndicator: false
            });

            // emojione is bundled (mainresources.py); the picker draws each
            // emoji as an image, since the sprite is a stylesheet from a CDN
            // that the Content-Security-Policy refuses. Its autocomplete would
            // fetch jquery-textcomplete from cdn.rawgit.com, a script from
            // another origin (and a CDN gone since 2019): it is off.
            $("#emojiarea").emojioneArea({
                sprite: false,
                autocomplete: false,
                pickerPosition: "bottom",
                filtersPosition: "bottom",
                tonesStyle: "checkbox"
            });

        });
    </script>
{% endblock scripts %}