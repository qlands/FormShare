# .coveragerc to control coverage.py
[run]
source = formshare
omit = */utilities/*
# The suite boots the app again in a subprocess for the settings that are
# read at startup (tests/steps/settings_at_startup.py); measure it too
patch = subprocess

[paths]
source =
    formshare/
    */site-packages/

[report]
omit = */utilities/*
show_missing = True
exclude_lines =
    pragma: no cover
    except