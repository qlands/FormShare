{% extends 'dashboard/page.jinja2' %}
{% import 'dashboard/macros/form.jinja2' as form %}

{% block titlesection %}{{ _("Edit list") }}{% endblock titlesection %}

{% block css %}
    {{ super() }}
    {% cssresource request,'formshare','select2' %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jQuery-QueryBuilder/3.0.0/css/query-builder.default.min.css">
{% endblock css %}

{% block topScripts %}
    {{ super() }}
    {% jsresource request,'formshare','select2' %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jQuery-QueryBuilder/3.0.0/js/query-builder.standalone.min.js"></script>
{% endblock topScripts %}

{% block breadcrumbs %}
    {% set crumb_current = listData.list_filename %}
    {% include 'dashboard/projects/case_management/snippets/brdcrbs_case_lists.jinja2' %}
{% endblock breadcrumbs %}

{% block maincontent %}
    <div class="row">
        <div class="col-lg-12">
            {% block form_errors %}
                {{ form.display_errors(errors) }}
            {% endblock form_errors %}
            <div class="ibox">
                <div class="ibox-content">
                    <h2><code>{{ listData.list_filename }}</code></h2>
                    <p>
                        {{ _('Served from') }} <b>{{ listData.source_form }}</b> / <b>{{ listData.source_table }}</b>.
                        {{ _('Every list carries name (the row identity) and label. The columns below are served in addition, in this order.') }}
                    </p>
                    <div class="hr-line-dashed"></div>
                    <h3>{{ _('Key') }}</h3>
                    <form method="post" class="form-inline">
                        {{ form.secure_form(request) }}
                        <select name="list_key_column" id="list_key_column" class="form-control" style="min-width: 250px">
                            <option value="" {% if not listData.list_key_column %}selected{% endif %}>{{ _('Each row (keyed by its rowuuid)') }}</option>
                            {% for a_column in tableColumns %}
                                <option value="{{ a_column.field_name }}" {% if a_column.field_name == listData.list_key_column %}selected{% endif %}>{{ a_column.field_name }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" name="change_key" value="1" class="btn btn-white">{{ _('Change the key') }}</button>
                        <span class="form-text m-b-none">{{ _('A column key serves each distinct value once; such a list cannot be a case link.') }}</span>
                    </form>
                    <div class="hr-line-dashed"></div>
                    <h3>{{ _('Rows to serve') }}</h3>
                    <form method="post" class="form-inline">
                        {{ form.secure_form(request) }}
                        <select name="list_active" class="form-control" style="min-width: 200px">
                            <option value="1" {% if listData.list_active == 1 %}selected{% endif %}>{{ _('Active cases') }}</option>
                            <option value="0" {% if listData.list_active == 0 %}selected{% endif %}>{{ _('Inactive cases') }}</option>
                        </select>
                        <button type="submit" name="change_active" value="1" class="btn btn-white">{{ _('Change') }}</button>
                    </form>
                    <div class="hr-line-dashed"></div>
                    <h3>{{ _('Filter') }}</h3>
                    <p class="text-muted">{{ _('Serve only the rows that match. The same for every assistant, on the server and on the devices, which apply it to the rows they have not sent yet. Texts are compared exactly as written, capitals and spaces included.') }}</p>
                    {% if filterWords %}
                        <p id="filter-words">{{ _('Serves the rows where') }} <b>{{ filterWords }}</b>.</p>
                    {% else %}
                        <p id="filter-words">{{ _('No filter: every row is served.') }}</p>
                    {% endif %}
                    <form method="post" id="filter-form">
                        {{ form.secure_form(request) }}
                        <div id="filter-builder"></div>
                        <input type="hidden" name="filter_rules" id="filter-rules" value="">
                        <button type="submit" name="change_filter" value="1" class="btn btn-primary">{{ _('Save the filter') }}</button>
                        {% if filterWords %}
                            <button type="submit" name="clear_filter" value="1" class="btn btn-white" id="filter-clear">{{ _('Remove the filter') }}</button>
                        {% endif %}
                    </form>
                    <div class="hr-line-dashed"></div>
                    <h3>{{ _('Label') }}</h3>
                    <form method="post" class="form-inline">
                        {{ form.secure_form(request) }}
                        <select name="label_column" id="label_column" class="form-control" style="min-width: 250px">
                            {% for a_column in tableColumns %}
                                <option value="{{ a_column.field_name }}" {% if a_column.field_name == listData.label_column %}selected{% endif %}>{{ a_column.field_name }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" name="change_label" value="1" class="btn btn-white">{{ _('Change the label column') }}</button>
                    </form>
                    <div class="hr-line-dashed"></div>
                    <h3>{{ _('Served columns') }}</h3>
                    {% if listColumns %}
                        <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>{{ _('Column') }}</th>
                                <th>{{ _('Served as') }}</th>
                                <th>{{ _('Actions') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for a_column in listColumns %}
                                <tr>
                                    <td>{{ a_column.column_name }}{% if a_column.column_source == 'property' %} <span class="label label-info">{{ _('property') }}</span>{% endif %}</td>
                                    <td>{{ a_column.column_as or a_column.column_name }}</td>
                                    <td>
                                        <form method="post" style="display: inline">
                                            {{ form.secure_form(request) }}
                                            <input type="hidden" name="column_name" value="{{ a_column.column_name }}">
                                            <button type="submit" name="remove_column" value="1" class="btn btn-xs btn-danger">{{ _('Remove') }}</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p>{{ _('Only name and label are served.') }}</p>
                    {% endif %}
                    <form method="post" class="form-inline">
                        {{ form.secure_form(request) }}
                        <select name="column_name" id="column_name" class="form-control" style="min-width: 250px">
                            <optgroup label="{{ _('Columns') }}">
                                {% for a_column in tableColumns %}
                                    <option value="{{ a_column.field_name }}">{{ a_column.field_name }}</option>
                                {% endfor %}
                            </optgroup>
                            {% if tableProperties %}
                                <optgroup label="{{ _('Properties') }}">
                                    {% for a_property in tableProperties %}
                                        <option value="property:{{ a_property.property_name }}">{{ a_property.property_name }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endif %}
                        </select>
                        <input type="text" name="column_as" class="form-control" placeholder="{{ _('Served as (optional)') }}">
                        <button type="submit" name="add_column" value="1" class="btn btn-primary">{{ _('Add the column') }}</button>
                    </form>
                    <div class="hr-line-dashed"></div>
                    <a class="btn btn-white" href="{{ request.route_url('project_case_lists', userid=userid, projcode=projcode) }}">{{ _('Back to the lists') }}</a>
                </div>
            </div>
        </div>
    </div>
{% endblock maincontent %}

{% block scripts %}
    {{ super() }}
    <script>
        var filterFields = {{ filterFields|tojson }};
        var filterRules = {{ filterRules|tojson }};
        $(document).ready(function() {
            $("#label_column").select2();
            $("#column_name").select2();
            $("#list_key_column").select2();
            if (filterFields.length) {
                $("#filter-builder").queryBuilder({
                    filters: filterFields,
                    allow_empty: true,
                    plugins: ["not-group"],
                    icons: { add_group: "fas fa-plus-circle", add_rule: "fas fa-plus", remove_group: "fas fa-times", remove_rule: "fas fa-times", error: "fas fa-exclamation-triangle" }
                });
                $("#filter-builder").queryBuilder("setRules", filterRules && filterRules.rules ? filterRules : {condition: "AND", rules: []});
            }
            $("#filter-form").on("submit", function (e) {
                if (e.originalEvent && e.originalEvent.submitter && e.originalEvent.submitter.id === "filter-clear") { return true; }
                if (!filterFields.length) { return true; }
                var rules = $("#filter-builder").queryBuilder("getRules", {allow_invalid: false});
                if (rules === null) { return false; }
                $("#filter-rules").val(rules.rules && rules.rules.length ? JSON.stringify(rules) : "");
                return true;
            });
        });
    </script>
{% endblock scripts %}
