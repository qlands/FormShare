# Copy to .env and adjust values.
# Never commit .env with real passwords.

# Compose
COMPOSE_PROJECT_NAME=formshare
FS_NETWORK_NAME=formshare_fsnet

# Base host directory for persistent data
FS_DATA_DIR=/opt/formshare_community

# FormShare image
FORMSHARE_IMAGE=qlands/formshare2_community:20260218

# MySQL
MYSQL_ROOT_PASSWORD=change_me_mysql_root

# Elasticsearch (a single node -- see the notes at the top of servers.yml)
ES_CLUSTER_NAME=fs-es-cluster
ES_IMAGE_TAG=9.2.1
ELASTIC_PASSWORD=change_me_elastic

# Heap is not the resource that grows with your data. Aggregations over
# geo_point and keyword fields read doc values, which are memory-mapped and
# served from the OS page cache, so heap stays flat while the index grows.
# Measured at ten million GPS points on one shard: the heaviest map query
# (every point scanned, ten thousand clusters) answered in ~80 ms with the
# fielddata and request breakers at zero and no circuit breaker trips under
# 16-way concurrency. Raise this only if you see GC pressure -- not because the
# index got bigger.
ES_HEAP=512m

# What that costs in RAM. The heap is pre-touched, so it is resident from
# startup, and the JVM adds roughly 260 MB of metaspace and code cache plus
# thread stacks on top:
#
#   one node at 512m  ->  ~0.9 GB      (two nodes at 512m was ~1.8 GB)
#   one node at 1g    ->  ~1.4 GB
#
# Separately, the index itself should fit in free RAM as page cache -- roughly
# 2 GB per ten million submissions. That memory is shared and reclaimable, not
# consumed by the process.

# Indices are created with one shard and no replica. A replica needs a second
# node to live on and would otherwise leave every index yellow. Override per
# index in the FormShare ini if you ever run more than one node:
#   elasticsearch.repository.number_of_shards / .number_of_replicas
#   elasticsearch.records.number_of_shards    / .number_of_replicas
#   elasticsearch.user.number_of_shards       / .number_of_replicas
#   elasticsearch.partner.number_of_shards    / .number_of_replicas
# Shards cannot be changed after an index exists -- only reindexed or _split.
# Replicas can be changed at any time.

# FormShare
MYSQL_USER_NAME=root
MYSQL_USER_PASSWORD=change_me_mysql_root
FORMSHARE_ADMIN_USER=admin
FORMSHARE_ADMIN_EMAIL=admin@myserver.com
FORMSHARE_ADMIN_PASSWORD=change_me_admin

# Network/service discovery (defaults are fine)
MYSQL_HOST_NAME=mysql
ELASTIC_SEARCH_HOST=es01
ELASTIC_SEARCH_PORT=9200
ELASTIC_USER=elastic

# Ports (host:container)
FORMSHARE_PORT=5900
FORMSHARE_MONITORING_PORT=9001

# If you run behind a reverse proxy, restrict this (e.g., 172.18.0.0/16)
FORWARDED_ALLOW_IP=*

# Startup wait
WAIT_HOSTS_TIMEOUT=360
WAIT_HOSTS=mysql:3306,es01:9200
