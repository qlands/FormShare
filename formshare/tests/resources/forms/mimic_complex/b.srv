{
    "type": "survey",
    "name": "data",
    "title": "Sequia_LB_20190123",
    "id_string": "LB_Sequia_MAG_20190123",
    "sms_keyword": "LB_Sequia_MAG_20190123",
    "default_language": "Spanish",
    "children": [
        {
            "type": "note",
            "name": "title_note",
            "label": "Encuesta \"LíneaBase_Sequía_2018+2019 \""
        },
        {
            "type": "group",
            "name": "SECTION_META",
            "label": "Sección METADATA",
            "children": [
                {
                    "type": "note",
                    "label": "Introducción",
                    "name": "generated_note_name_4"
                },
                {
                    "type": "text",
                    "name": "interviewername",
                    "label": "Nombre del entrevistador"
                },
                {
                    "type": "deviceid",
                    "name": "deviceid"
                },
                {
                    "type": "start",
                    "name": "starttime_auto"
                },
                {
                    "type": "calculate",
                    "name": "starttime_calculated",
                    "bind": {
                        "calculate": "once(if(boolean-from-string(${interviewername}), format-date-time(now(), '%H:%M:%S'), format-date-time(now(), '%H:%M:%S')))"
                    }
                }
            ]
        },
        {
            "type": "group",
            "name": "agreement_group",
            "control": {
                "appearance": "field-list"
            },
            "children": [
                {
                    "type": "note",
                    "name": "agreement",
                    "label": "Hola, mi nombre es ${interviewername}. La información recabada en esta encuesta es con propósitos técnicos y es estrictamente confidencial"
                },
                {
                    "type": "select one",
                    "name": "participation",
                    "label": "¿Esta usted de acuerdo en proveer información para esta encuesta?",
                    "bind": {
                        "required": "yes",
                        "jr:requiredMsg": "¡ Esta respuesta es necesaria !"
                    },
                    "parameters": {},
                    "itemset": "yes_no",
                    "list_name": "yes_no",
                    "choices": [
                        {
                            "name": "Y",
                            "label": "Si"
                        },
                        {
                            "name": "N",
                            "label": "No"
                        }
                    ]
                }
            ]
        },
        {
            "type": "note",
            "label": "AGRADEZCA A LAS PERSONAS POR SU TIEMPO Y ABANDONE LA CASA",
            "bind": {
                "relevant": "${participation} = 'N'"
            },
            "name": "generated_note_name_15"
        },
        {
            "type": "group",
            "name": "si_participa",
            "bind": {
                "relevant": "${participation} = 'Y'"
