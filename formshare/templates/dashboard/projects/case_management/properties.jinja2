{% extends 'dashboard/page.jinja2' %}
{% import 'dashboard/macros/form.jinja2' as form %}

{% block titlesection %}{{ _("Properties") }}{% endblock titlesection %}

{% block css %}
    {{ super() }}
    {% cssresource request,'formshare','select2' %}
{% endblock css %}

{% block topScripts %}
    {{ super() }}
    {% jsresource request,'formshare','select2' %}
{% endblock topScripts %}

{% block breadcrumbs %}
    {% set crumb_current = _('Properties') %}
    {% include 'dashboard/projects/case_management/snippets/brdcrbs_case_lists.jinja2' %}
{% endblock breadcrumbs %}

{% block maincontent %}
    <div class="row">
        <div class="col-lg-12">
            {% block form_errors %}
                {{ form.display_errors(errors) }}
            {% endblock form_errors %}
            <div class="ibox">
                <div class="ibox-content">
                    <h2>{{ _('Properties') }}</h2>
                    <p>
                        {{ _("A property is an extra variable FormShare keeps linked to a table that publishes a list but is not part of the original ODK form. For example, a patient's condition that might change with every follow-up.") }}
                    </p>
                    <div class="form-inline">
                        <select id="form_id" class="form-control" style="min-width: 300px">
                            <option value="">{{ _('Select a form') }}</option>
                            {% for a_form in forms %}
                                <option value="{{ a_form.form_id }}" {% if a_form.form_id == formId %}selected{% endif %}>{{ a_form.form_name }} ({{ a_form.form_id }})</option>
                            {% endfor %}
                        </select>
                        <select id="table_name" class="form-control" style="min-width: 250px" {% if not formId %}disabled{% endif %}>
                            <option value="">{{ _('Select a table') }}</option>
                            {% for a_table in tables %}
                                <option value="{{ a_table.table_name }}" {% if a_table.table_name == tableName %}selected{% endif %}>{{ a_table.table_name }}{% if a_table.table_desc %} &#8212; {{ a_table.table_desc }}{% endif %}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% if formId and tableName %}
                        <hr class="hr-line-dashed">
                        <h3>{{ _('Properties of') }} {{ tableName }}</h3>
                        {% if properties %}
                            <table class="table table-striped">
                                <thead>
                                <tr>
                                    <th>{{ _('Property') }}</th>
                                    <th>{{ _('Type') }}</th>
                                    <th>{{ _('Default') }}</th>
                                    <th>{{ _('Description') }}</th>
                                    <th>{{ _('Actions') }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for a_property in properties %}
                                    <tr>
                                        <td>{{ a_property.property_name }}</td>
                                        <td>{{ propertyTypes|selectattr(0, 'equalto', a_property.property_type)|map(attribute=1)|first or a_property.property_type }}</td>
                                        <td>{% if a_property.property_default is none %}<i>NULL</i>{% else %}{{ a_property.property_default }}{% endif %}</td>
                                        <td>{{ a_property.property_desc or '' }}</td>
                                        <td>
                                            <form method="post" style="display: inline">
                                                {{ form.secure_form(request) }}
                                                <input type="hidden" name="property_name" value="{{ a_property.property_name }}">
                                                <button type="submit" name="delete_property" value="1" class="btn btn-xs btn-danger">{{ _('Delete') }}</button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <p>{{ _('This table has no properties yet.') }}</p>
                        {% endif %}
                        <form method="post" class="form-inline">
                            {{ form.secure_form(request) }}
                            <input type="text" name="property_name" class="form-control" placeholder="{{ _('Property name') }}" style="min-width: 200px; margin-right: 5px">
                            <select name="property_type" id="property_type" class="form-control" style="min-width: 160px">
                                {% for code, label in propertyTypes %}
                                    <option value="{{ code }}">{{ label }}</option>
                                {% endfor %}
                            </select>
                            <input type="text" name="property_default" class="form-control" placeholder="{{ _('Default (empty = NULL)') }}" style="min-width: 220px; margin-left: 5px">
                            <input type="text" name="property_desc" class="form-control" placeholder="{{ _('Description (optional)') }}" style="min-width: 250px; margin-left: 5px">
                            <button style="margin-left: 10px" type="submit" name="add_property" value="1" class="btn btn-primary">{{ _('Add the property') }}</button>
                        </form>
                        <p class="help-block">
                            <br/>{{ _("The default value may need a specific format depending on its type: A date is YYYY-MM-DD, a date and time is YYYY-MM-DD HH:MM:SS; a geopoint is latitude, longitude, altitude, and accuracy separated by spaces; a trace or shape lists geopoints separated by semicolons.") }}
                            <br/>{{ _('The server time now is') }} <strong>{{ serverTime }}</strong>.
                        </p>
                    {% endif %}
                    <div class="hr-line-dashed"></div>
                    <a class="btn btn-white" href="{{ request.route_url('project_case_lists', userid=userid, projcode=projcode) }}">{{ _('Back to the lists') }}</a>
                </div>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function() {
            var base = "{{ request.route_url('project_case_properties', userid=userid, projcode=projcode) }}";
            $("#form_id").select2();
            $("#table_name").select2();
            $("#property_type").select2({minimumResultsForSearch: -1});
            $("#form_id").on("change", function() {
                location.href = base + "?form=" + encodeURIComponent($(this).val());
            });
            $("#table_name").on("change", function() {
                location.href = base + "?form=" + encodeURIComponent($("#form_id").val()) + "&table=" + encodeURIComponent($(this).val());
            });
        });
    </script>
{% endblock maincontent %}
