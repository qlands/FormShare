{% extends 'dashboard/page.jinja2' %}
{% import 'dashboard/macros/form.jinja2' as form %}

{% block titlesection %}{{ _("Form actions") }}{% endblock titlesection %}

{% block css %}
    {{ super() }}
    <style>
      .act-rows td { vertical-align: middle; }
      .act-rows .act-what { max-width: 640px; }
      .act-rows .act-row-buttons { white-space: nowrap; text-align: right; }
      .act-row-buttons > *, .act-top > * { margin-right: 4px; margin-bottom: 4px; }
      .act-code-view { font-family: SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; background: #f8f9fa; border: 1px solid #e5e7eb; padding: 10px; max-height: 60vh; overflow: auto; white-space: pre; margin: 0; }
    </style>
{% endblock css %}

{% block topScripts %}
    {{ super() }}
    {% jsresource request,'formshare','clipboard' %}
    {% jsresource request,'formshare','htmx' %}
{% endblock topScripts %}

{% block breadcrumbs %}
    {% include 'dashboard/projects/case_management/snippets/brdcrbs_case_actions.jinja2' %}
{% endblock breadcrumbs %}

{% block maincontent %}
    <div class="row">
        <div class="col-lg-12">
            {% block form_errors %}
                {{ form.display_errors(errors) }}
            {% endblock form_errors %}
            <div class="ibox">
                <div class="ibox-content">
                    <h2>{{ _('Form actions') }} &mdash; {{ formData.form_name }}</h2>
                    <p>
                        {{ _('What happens to the case each time this form is submitted: a property set, a column changed, the case deactivated or reactivated. The actions run on the server after every submission is stored, and on FormShare Collect at finalize for a case registered on the same device.') }}
                        {% if source and not source.own %}
                            {{ _('This form follows up') }} <b>{{ source.table }}</b> {{ _('of') }} <b>{{ source.form }}</b> ({{ _('through') }} <code>{{ source.selector_field }}</code>){% if source.parent_table %}, {{ _('whose parent is') }} <b>{{ source.parent_table }}</b>{% endif %}.
                        {% else %}
                            <span class="text-warning">{{ _('This form has no case link, so its actions act on its own rows: the case is each submission itself. To act on a case of another form, set the case link in "Links to lists" first.') }}</span>
                        {% endif %}
                    </p>
                    <div class="act-top">
                        <a class="btn btn-primary" href="{{ request.route_url('form_case_action_add', userid=userid, projcode=projcode, formid=formData.form_id) }}"><i class="fas fa-plus"></i> {{ _('Add an action') }}</a>
                        <a class="btn btn-white" href="{{ request.route_url('form_case_action_add_code', userid=userid, projcode=projcode, formid=formData.form_id) }}"><i class="fas fa-code"></i> {{ _('Add an action (Expert mode)') }}</a>
                    </div>
                    <hr class="hr-line-dashed">
                    {# What the arrows change in place: the page fetches it again (?partial=actions_list) #}
                    <div id="act-list">
                    {% partial_start 'actions_list' %}
                    {# The list's own address for the arrows, not request.url: in the fragment,
                       that is ?partial=actions_list, and the cross-post check refuses a post there #}
                    {% set list_url = request.route_url('form_case_actions', userid=userid, projcode=projcode, formid=formData.form_id) %}
                    {% if actions %}
                        <table class="table table-striped act-rows">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>{{ _('What it does') }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for an_action in actions %}
                                <tr>
                                    <td>{{ an_action.number }}</td>
                                    <td class="act-what">
                                        {% if an_action.action_kind == 'code' %}
                                            <span class="label label-info">{{ _('Expert') }}</span>
                                            {{ an_action.words if an_action.words else _('Code written by hand') }}
                                        {% elif an_action.broken %}
                                            <span class="text-danger">{{ an_action.broken }}</span>
                                        {% else %}
                                            {{ an_action.words }}
                                        {% endif %}
                                    </td>
                                    <td class="act-row-buttons">
                                        <button type="button" class="btn btn-xs btn-white act-see-code" data-title="{{ _('Action') }} {{ an_action.number }}" data-code="act-code-{{ an_action.number }}"><i class="fas fa-file-code"></i> {{ _('See code') }}</button>
                                        <a class="btn btn-xs btn-white" href="{{ request.route_url('form_case_action_test', userid=userid, projcode=projcode, formid=formData.form_id, actionid=an_action.action_id) }}"><i class="fas fa-vial"></i> {{ _('Test') }}</a>
                                        {% if an_action.action_kind == 'code' %}
                                            <a class="btn btn-xs btn-white" href="{{ request.route_url('form_case_action_code', userid=userid, projcode=projcode, formid=formData.form_id, actionid=an_action.action_id) }}"><i class="fas fa-pencil-alt"></i> {{ _('Edit') }}</a>
                                        {% else %}
                                            <a class="btn btn-xs btn-white" href="{{ request.route_url('form_case_action_edit', userid=userid, projcode=projcode, formid=formData.form_id, actionid=an_action.action_id) }}"><i class="fas fa-pencil-alt"></i> {{ _('Edit') }}</a>
                                        {% endif %}
                                        <form method="post" action="{{ list_url }}" hx-post="{{ list_url }}" hx-swap="none" style="display: inline">
{{ form.secure_form(request) }}
                                            <input type="hidden" name="action_id" value="{{ an_action.action_id }}">
                                            <button type="submit" name="move_up" value="1" class="btn btn-xs btn-white" title="{{ _('Move up') }}" {% if loop.first %}disabled{% endif %}><i class="fas fa-arrow-up"></i></button>
                                            <button type="submit" name="move_down" value="1" class="btn btn-xs btn-white" title="{{ _('Move down') }}" {% if loop.last %}disabled{% endif %}><i class="fas fa-arrow-down"></i></button>
                                        </form>
                                        <button type="button" class="btn btn-xs btn-danger act-remove" data-id="{{ an_action.action_id }}" data-number="{{ an_action.number }}"><i class="fas fa-trash"></i> {{ _('Remove') }}</button>
                                        <textarea id="act-code-{{ an_action.number }}" class="d-none" readonly>{{ an_action.code }}</textarea>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        <p class="text-muted">{{ _('When two actions change the same thing, the one higher in the list wins. If one action fails on a submission, none of them is applied, and the run below says which one failed and where.') }}</p>
                    {% else %}
                        <p>{{ _('No actions yet.') }}</p>
                    {% endif %}
                    {% partial_end 'actions_list' %}
                    </div>

                    <hr class="hr-line-dashed">
                    <h3>{{ _('Runs') }} {% if failedRuns > 0 %}<span class="label label-danger">{{ failedRuns }} {{ _('failed') }}</span>{% endif %}</h3>
                    {% if runs|length > 0 %}
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>{{ _('When') }}</th>
                                    <th>{{ _('Submission') }}</th>
                                    <th>{{ _('Status') }}</th>
                                    <th>{{ _('Changes') }}</th>
                                    <th>{{ _('Message') }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for a_run in runs %}
                                <tr>
                                    <td>{{ a_run.run_dtime }}</td>
                                    <td><code>{{ a_run.submission_id or a_run.main_rowuuid }}</code>{% if a_run.instance_id %}<div class="text-muted" title="{{ _('The submission as the device knows it: its instanceID') }}"><code>{{ a_run.instance_id }}</code></div>{% endif %}</td>
                                    <td>{% if a_run.run_status == 0 %}<span class="label label-primary">{{ _('applied') }}</span>{% elif a_run.run_status == 2 %}<span class="label label-default" title="{{ _('The submission was deleted and what this run wrote was put back') }}">{{ _('taken back') }}</span>{% else %}<span class="label label-danger">{{ _('failed') }}</span>{% endif %}</td>
                                    <td>
                                        {% for a_change in a_run.run_changes %}
                                            <div><code>{{ a_change.table }}.{{ a_change.column }}</code>: {{ a_change.old if a_change.old is not none else 'NULL' }} &rarr; {{ a_change.new if a_change.new is not none else 'NULL' }}</div>
                                        {% else %}&mdash;{% endfor %}
                                    </td>
                                    <td>{{ a_run.run_message or '' }}{% for a_line in a_run.run_log %}<div class="text-muted">{{ a_line }}</div>{% endfor %}</td>
                                    <td>
                                        {% if a_run.run_status == 1 %}
                                            <form method="post" action="{{ request.url }}" style="display: inline">
{{ form.secure_form(request) }}
                                                <input type="hidden" name="run_id" value="{{ a_run.run_id }}">
                                                <button type="submit" name="retry_run" value="1" class="btn btn-xs btn-white">{{ _('Retry') }}</button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="text-muted">{{ _('No submission has run through the actions yet.') }}</p>
                    {% endif %}

                    <a class="btn btn-white m-t" href="{{ request.route_url('form_details', userid=userid, projcode=projcode, formid=formData.form_id) }}">{{ _('Back to the form') }}</a>
                </div>
            </div>
        </div>
    </div>

    <div class="modal inmodal" id="act-code-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content animated fadeIn">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">{{ _('Close') }}</span></button>
                    <h4 class="modal-title" id="act-code-title"></h4>
                </div>
                <div class="modal-body">
                    <pre class="act-code-view" id="act-code-text"></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" id="act-code-copy" data-clipboard-target="#act-code-text"><i class="fas fa-copy"></i> <span>{{ _('Copy') }}</span></button>
                    <button type="button" class="btn btn-primary" data-dismiss="modal">{{ _('Close') }}</button>
                </div>
            </div>
        </div>
    </div>
    <form id="act-remove-form" method="post" action="{{ request.url }}" style="display: none">
{{ form.secure_form(request) }}
        <input type="hidden" name="action_id" id="act-remove-id" value="">
        <input type="hidden" name="delete_action" value="1">
    </form>
{% endblock maincontent %}

{% block scripts %}
    {{ super() }}
    <script>
      // htmx evaluates strings only for hx-on, hx-vars and js: values, none
      // of which FormShare uses, and the Content-Security-Policy refuses eval
      // (formshare/config/csp.py).
      htmx.config.allowEval = false;
      // An arrow moves its action without leaving the page: the server says
      // so (HX-Trigger), and the list is fetched again in place.
      document.addEventListener("formshare:actions-updated", function () {
        htmx.ajax("GET", window.location.pathname + "?partial=actions_list", {target: "#act-list", swap: "innerHTML"});
      });
      document.addEventListener("formshare:notify", function (e) {
        swal({title: e.detail.type, text: e.detail.message, type: e.detail.type});
      });
      $(document).on("click", ".act-see-code", function () {
        $("#act-code-title").text($(this).attr("data-title"));
        $("#act-code-text").text(document.getElementById($(this).attr("data-code")).value);
        $("#act-code-copy span").text({{ _('Copy')|tojson }});
        $("#act-code-modal").modal("show");
      });
      $(document).ready(function () {
        // In a dialog the copy must happen inside it, where the focus is.
        var copier = new ClipboardJS("#act-code-copy", { container: document.getElementById("act-code-modal") });
        copier.on("success", function (event) {
          $("#act-code-copy span").text({{ _('Copied')|tojson }});
          event.clearSelection();
        });
      });
      $(document).on("click", ".act-remove", function () {
        var actionId = $(this).attr("data-id");
        swal({
          title: {{ _('Remove this action?')|tojson }} ,
          text: {{ _('Action')|tojson }} + " " + $(this).attr("data-number") + ": " + {{ _('it stops running on the submissions that arrive from now on. What it already changed stays.')|tojson }},
          type: "warning",
          showCancelButton: true,
          confirmButtonColor: "#DD6B55",
          confirmButtonText: {{ _('Yes, remove it')|tojson }},
          cancelButtonText: {{ _('Cancel')|tojson }},
          closeOnConfirm: true
        }, function (isConfirm) {
          if (isConfirm) {
            $("#act-remove-id").val(actionId);
            $("#busy").show();
            document.getElementById("act-remove-form").submit();
          }
        });
      });
    </script>
{% endblock scripts %}
