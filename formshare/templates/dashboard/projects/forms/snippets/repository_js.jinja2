(function () {
    var evtSource = new EventSource("/task_stream/{{ formDetails.form_reptask }}");
    evtSource.onmessage = function (e) {
        if (e.data === "success" || e.data === "failure") {
            evtSource.close();
            location.reload();
        } else {
            $(".repository_message").text(e.data);
        }
    };
    evtSource.onerror = function () {
        evtSource.close();
    };
})();

let $element = $('.repository_message, .sse-message');
function fadeInOut () {
    $element.fadeIn(1000, function () {
        $element.fadeOut(1500, function () {
            $element.fadeIn(1500, function () {
                setTimeout(fadeInOut, 500);
            });
        });
    });
}
fadeInOut();

$('.cancel-task').click(function () {
    var action_url = $( this ).attr('urn');
    swal({
            title: "{{ _('Cancel the process') }}",
            text: "{{ _('Are you sure that you want to cancel this process') }}",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: "{{ _('Yes, stop the process') }}",
            cancelButtonText: "{{ _('Oops!, cancel!') }}",
            closeOnConfirm: true,
            closeOnCancel: true },
        function (isConfirm) {
            if (isConfirm) {
                var form = document.createElement('form');
                form.setAttribute('method', 'post');
                form.setAttribute('action', action_url);
                form.style.display = 'hidden';

                var i = document.createElement("input"); //input element, text
                i.setAttribute('type',"text");
                i.setAttribute('name',"csrf_token");
                i.setAttribute('value','{{ request.session.get_csrf_token() }}');
                form.appendChild(i);

                document.body.appendChild(form);
                $("#busy").show();
                form.submit();
            }
        });
});
