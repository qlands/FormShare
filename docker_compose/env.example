# Copy to .env and adjust values.
# Never commit .env with real passwords.

# Compose
COMPOSE_PROJECT_NAME=formshare
FS_NETWORK_NAME=formshare_fsnet

# Base host directory for persistent data
FS_DATA_DIR=/opt/formshare_community

# FormShare image
FORMSHARE_IMAGE=qlands/formshare2_community:20260218

# MySQL
MYSQL_ROOT_PASSWORD=change_me_mysql_root

# Elasticsearch
ES_CLUSTER_NAME=fs-es-cluster
ES_HEAP=512m
ELASTIC_PASSWORD=change_me_elastic

# FormShare
MYSQL_USER_NAME=root
MYSQL_USER_PASSWORD=change_me_mysql_user
FORMSHARE_ADMIN_USER=admin
FORMSHARE_ADMIN_EMAIL=admin@myserver.com
FORMSHARE_ADMIN_PASSWORD=change_me_admin

# Network/service discovery (defaults are fine)
MYSQL_HOST_NAME=mysql
ELASTIC_SEARCH_HOST=es01
ELASTIC_SEARCH_PORT=9200
ELASTIC_USER=elastic

# Ports (host:container)
FORMSHARE_PORT=5900
FORMSHARE_MONITORING_PORT=9001

# If you run behind a reverse proxy, restrict this (e.g., 172.18.0.0/16)
FORWARDED_ALLOW_IP=*

# Startup wait
WAIT_HOSTS_TIMEOUT=360
WAIT_HOSTS=mysql:3306,es01:9200
