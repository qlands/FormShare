{% block project_form %}
    <form class="m-t require_busy" role="form" method="post" action="{{ request.url }}" enctype="multipart/form-data" >
        {{ form.secure_form(request) }}
        {% block project_form_code %}
            <div class="form-group row"><label class="col-sm-2 col-form-label">{{ _('Code') }}</label>
                <div class="col-sm-10"><input type="text" class="form-control" name="project_code" data-allowed-chars="[0-9a-zA-Z_]" value="{{ projectDetails.project_code }}"> <span class="form-text m-b-none">{{ _('The code must be unique and cannot be changed afterwards') }}</span> </div>
            </div>
        {% endblock project_form_code %}
        <div class="hr-line-dashed"></div>
        <div class="form-group row"><label class="col-sm-2 col-form-label">{{ _('Name') }}</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" name="project_name" value="{{ projectDetails.project_name }}">
            </div>
        </div>
        <div class="hr-line-dashed"></div>
        <div class="form-group row"><label class="col-sm-2 col-form-label">{{ _('Color') }}</label>
            <div class="col-sm-10">
                <input id="noIndColor" name="project_hexcolor" value="{{ projectDetails.project_hexcolor }}" />
                <span class="form-text m-b-none">{{ _('You will use this in ODK Collect to identify your project.') }}</span>
            </div>
        </div>
        <div class="hr-line-dashed"></div>
        <div class="form-group row"><label class="col-sm-2 col-form-label">{{ _('Icon') }}</label>
            <div class="col-sm-10"><div style="max-width: 100px"><input id="emojiarea" name="project_icon" value="{{ projectDetails.project_icon }}" /></div><span class="form-text m-b-none">{{ _('You will use this in ODK Collect to identify your project. Only the first Emoji will be used.') }}</span></div>
        </div>
        <div class="hr-line-dashed"></div>
        {% block project_form_logo %}
            {# The logo FormShare Collect shows on its main menu (processes/project_logo.py),
               drawn as the apps draw it: at most 64 points tall, on a light and a dark background. #}
            {% set logo_swatch = "display: inline-block; padding: 8px 12px; margin: 0 8px 8px 0; border: 1px solid #e5e6e7; border-radius: 4px; line-height: 0;" %}
            {% set logo_size = "max-height: 64px; max-width: 360px;" %}
            <div class="form-group row"><label class="col-sm-2 col-form-label">{{ _('Logo') }}</label>
                <div class="col-sm-10">
                    {% if projectDetails.project_logo_md5 %}
                        {% set logo_src = request.route_url('project_logo', projectid=projectDetails.project_id, _query={'v': projectDetails.project_logo_md5}) %}
                        <div id="project_logo_current">
                            <span style="{{ logo_swatch }} background: #ffffff;"><img src="{{ logo_src }}" alt="{{ projectDetails.project_name }}" style="{{ logo_size }}"></span>
                            <span style="{{ logo_swatch }} background: #1f1f1f;"><img src="{{ logo_src }}" alt="" style="{{ logo_size }}"></span>
                            <div><label><input type="checkbox" name="remove_logo" value="1"> {{ _('Remove the logo') }}</label></div>
                        </div>
                    {% endif %}
                    <input type="file" class="form-control-file" id="project_logo_file" name="project_logo_file" accept="image/png,image/webp">
                    <div id="project_logo_preview" class="m-t-sm" hidden>
                        <span style="{{ logo_swatch }} background: #ffffff;"><img alt="" style="{{ logo_size }}"></span>
                        <span style="{{ logo_swatch }} background: #1f1f1f;"><img alt="" style="{{ logo_size }}"></span>
                    </div>
                    <span class="form-text m-b-none">{{ _('Shown on the main menu of FormShare Collect, at most 64 points tall. A PNG with a transparent background, about four times as wide as it is tall, such as 1200 × 300 px: from square to 6:1, at least 192 px tall and at most 200 KB. A wider image is scaled down to 1600 px. Check that it reads on both backgrounds.') }}</span>
                </div>
            </div>
            <script>
                // The chosen file, drawn before it is sent. The server checks it on saving.
                document.addEventListener("DOMContentLoaded", function () {
                    var input = document.getElementById("project_logo_file");
                    var preview = document.getElementById("project_logo_preview");
                    if (!input || !preview) {
                        return;
                    }
                    var shown = null;
                    input.addEventListener("change", function () {
                        if (shown) {
                            URL.revokeObjectURL(shown);
                            shown = null;
                        }
                        var file = input.files && input.files[0];
                        if (!file) {
                            preview.hidden = true;
                            return;
                        }
                        shown = URL.createObjectURL(file);
                        preview.querySelectorAll("img").forEach(function (img) {
                            img.src = shown;
                        });
                        preview.hidden = false;
                    });
                });
            </script>
            <div class="hr-line-dashed"></div>
        {% endblock project_form_logo %}
        {% block project_timezone %}
            {% if request.h.get_setting(request,'use_timezones','False') == 'True' %}
                <div class="form-group row"><label class="col-sm-2 col-form-label">{{ _('Time zone') }}</label>
                    <div class="col-sm-10">
                        <select style="width: 100%" id="project_timezone" name="project_timezone" data-module="autocomplete" data-module-dropdown-class="lang-dropdown" data-module-container-class="lang-container">
                            {% for a_timezone in timezones %}
                                <option value="{{ a_timezone.timezone_code }}" {% if a_timezone.timezone_code == system_timezone %} selected {% endif %} >{{ a_timezone.timezone_name }} (UTC{{ a_timezone.timezone_utc_offset }})</option>
                            {% endfor %}
                        </select>
                        <span class="form-text m-b-none">{{ _("This should be the time zone where submissions happen. As a reference, FormShare's time zone is ") }} {{ system_timezone_name }} {% if system_timezone != "UTC" %}(UTC{{ system_timezone_offset }}){% endif %}</span>
                    </div>
                </div>
                <div class="hr-line-dashed"></div>
            {% endif %}
        {% endblock project_timezone %}
        <div class="form-group row"><label class="col-sm-2 col-form-label">{{ _('Abstract') }}</label>
            <div class="col-sm-10">
                <textarea class="form-control" name="project_abstract" data-provide="markdown" rows="10">{% if projectDetails.project_abstract != None %}{{ projectDetails.project_abstract }}{% endif %}</textarea>
            </div>
        </div>
        {% if request.h.feature_exists("workflows") == False %}
            <div class="hr-line-dashed"></div>
            <span><b>{{ _('Optional. False by default.') }}</b></span>
        {% endif %}
        {% block project_form_case %}
            {% if request.h.feature_exists("workflows") == False %}
                <div class="form-group row"><label class="col-sm-2 col-form-label">{{ _('Use a case/longitudinal workflow') }}</label>
                    <div class="col-sm-10"><input type="checkbox" name="project_case" class="js-switch" {% if projectDetails.project_case == 1 %}checked{% endif %} /><span class="form-text m-b-none">{% block case_comment %}{{ _('This means that the forms in this project and their submissions will be related to cases.') }} {{ _('Read more about longitudinal forms') }} <a target="_blank" href="{{ request.url_for_static('longitudinal_infographic_en.pdf') }}" style="color: #0a6aa1">{{ _('here') }}.</a> {% endblock case_comment %}</span></div>
                </div>
                <div class="hr-line-dashed"></div>
            {% endif %}
        {% endblock project_form_case %}
        <span><b>{{ _('Optional. True by default.') }}</b></span>
        <div class="form-group row"><label class="col-sm-2 col-form-label">{{ _('Requires authentication to accept data') }}</label>
            <div class="col-sm-10"><input type="checkbox" name="project_formlist_auth" class="js-switch2" {% if projectDetails.project_formlist_auth == 1 %}checked{% endif %} /><span class="form-text m-b-none">{% block form_list_comment %}{{ _('Uncheck if this project will allow crowdsourcing / public submissions. Please note that this will apply to all forms within this project.') }} {% endblock form_list_comment %}</span>{% if listsPerAssistant %}<span class="form-text text-warning m-b-none" id="lists-per-assistant">{{ _('It stays checked while these lists serve each assistant their own cases, since public submissions name no assistant:') }} {{ listsPerAssistant|join(', ') }}. {{ _('Set them to serve every case first.') }}</span>{% endif %}</div>
        </div>
        <div class="hr-line-dashed"></div>
        {% block project_form_controls_extra %}

        {% endblock project_form_controls_extra %}
        {% block project_form_actions %}
            <div class="form-group row">
                <div class="col-sm-4 col-sm-offset-2">
                    <button class="btn btn-primary btn-sm" type="submit">{{ _('Add project') }}</button>
                </div>
            </div>
        {% endblock project_form_actions %}
    </form>
{% endblock project_form %}