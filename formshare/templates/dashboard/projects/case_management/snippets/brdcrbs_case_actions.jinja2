<div class="col-sm-12">
    <h2>{{ _('Form actions') }}</h2>
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ request.route_url("dashboard",userid=activeUser.login) }}">{{ _('Dashboard') }}</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ request.route_url("projects",userid=activeUser.id) }}">{{ _('Projects') }}</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ request.route_url("project_details",userid=projectDetails.owner, projcode=projectDetails.project_code) }}">{{ projectDetails.project_name }}</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ request.route_url("form_details",userid=projectDetails.owner, projcode=projectDetails.project_code, formid=formData.form_id) }}">{{ formData.form_name }}</a>
        </li>
        {% if crumb_current %}
            <li class="breadcrumb-item">
                <a href="{{ request.route_url("form_case_actions",userid=projectDetails.owner, projcode=projectDetails.project_code, formid=formData.form_id) }}">{{ _('Form actions') }}</a>
            </li>
            <li class="breadcrumb-item active">
                <strong>{{ crumb_current }}</strong>
            </li>
        {% else %}
            <li class="breadcrumb-item active">
                <strong>{{ _('Form actions') }}</strong>
            </li>
        {% endif %}
    </ol>
</div>
